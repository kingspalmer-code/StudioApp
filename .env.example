# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Timezone used to work out "today" for deadlines
NEXT_PUBLIC_TIMEZONE=Europe/London
# Sending quotes and invoices from the business's own Gmail (Settings > Quotes & invoices > Sending).
# From a Google Cloud OAuth client (Web application) with redirect URI https://<site>/api/mail/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Gmail sign-ins: openssl rand -base64 32
MAIL_TOKEN_KEY=
