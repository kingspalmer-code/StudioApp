{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "oatcake",
  "description": "Lets oatcake.xyz, shown in the app window, send Mac notifications.",
  "windows": ["main"],
  "remote": { "urls": ["https://oatcake.xyz/*", "https://*.oatcake.xyz/*"] },
  "permissions": [
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
